        "window_placement",
        "workspace_ui"
      ]
    },
    "live": {
      "command": "scripts/test-agent-harness.sh --live",
      "description": "Unit gate plus pinned real Codex/OpenCode runtime smoke and canary.",
      "required_suites": [
        "model_gateway",
        "agent_tool_server",
        "opencode_live_turn",
        "opencode_supervisor",
        "codex_live_turn",
        "runtime_canary"
      ]
    },
    "e2e": {
      "command": "scripts/test-agent-harness.sh --e2e",
      "description": "Live gate plus isolated signed-app UI, hotkey, tool, failure, and persistence checks.",
      "required_suites": [
        "signed_e2e"
      ]
    },
    "release": {
      "command": "scripts/test-agent-harness.sh --release",
      "description": "E2E gate plus the four-hour three-agent soak and release evidence audit.",
      "required_suites": [
        "release_soak"
      ]
    }
