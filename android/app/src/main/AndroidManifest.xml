<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Floating bubble (ticket VF-51) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="Voice Flow"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.VoiceFlow"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share target: shared text or an image lands in the assistant. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- No-UI router for the assist gesture: bubble running → toggle its
             recording in place (frontmost app keeps focus); otherwise open
             the app recording, as before (ticket VF-51). -->
        <!-- taskAffinity="" keeps it out of the app's task: a side-key press
             must never drag a backgrounded MainActivity to the front. -->
        <activity
            android:name=".DictateTrampoline"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- Invisible alias that jumps straight into quick capture. It holds
             the ASSIST role so the side-key LONG press starts dictation
             directly (Settings > Apps > Choose default apps > Digital
             assistant app > VF Dictate, side key long press on "Digital
             assistant"). Deliberately NOT a launcher entry — Safet doesn't
             want a second icon in the app drawer. Routes through the
             trampoline so an enabled bubble handles it without opening the
             app. -->
        <activity-alias
            android:name=".Dictate"
            android:targetActivity=".DictateTrampoline"
            android:exported="true"
            android:label="VF Dictate"
            android:icon="@mipmap/ic_dictate">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- The always-on floating dictation bubble (ticket VF-51). Lives as
             specialUse and claims the microphone type only while recording,
             so background starts (boot, sticky restart) stay legal. -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating dictation bubble overlay" />
        </service>

        <!-- Inserts finished transcripts into the focused field of any app;
             the bind permission means only the system can attach. -->
        <service
            android:name=".InsertionService"
            android:exported="true"
            android:label="Voice Flow"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <receiver android:name=".BubbleBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".RecordTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="Voice Flow dictate"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
